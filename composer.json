    "type": "october-plugin",
    "description": "Display markdown files in the backend for documentation purposes",
    "require": {
        "composer/installers": "~1.0",
        "scrivo/highlight.php": "^9.18"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "homepage": "https://github.com/egerstudios/oc-markdowndocs-plugin",
    "keywords": [
        "october",
        "octobercms",
        "documentation",
        "markdown"
    ],
